{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-plain", "title": "Plain (no page hero)", "postTypes": [ "page" ] }
	],
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "768px",
			"wideSize": "1280px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "name": "Primary",        "slug": "primary",           "color": "oklch(0.3000 0.1800 320)" },
				{ "name": "Primary Contrast","slug": "primary-contrast",  "color": "#ffffff" },
				{ "name": "Foreground",     "slug": "foreground",        "color": "oklch(0.3211 0 0)" },
				{ "name": "Background",     "slug": "background",        "color": "#ffffff" },
				{ "name": "Muted",          "slug": "muted",             "color": "oklch(0.9846 0.0030 320)" },
				{ "name": "Muted Text",     "slug": "muted-foreground",  "color": "oklch(0.5510 0.0300 320)" },
				{ "name": "Accent",         "slug": "accent",            "color": "oklch(0.9514 0.0350 320)" },
				{ "name": "Border",         "slug": "border",            "color": "oklch(0.9276 0.0080 320)" }
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{ "name": "Inter",          "slug": "sans",  "fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" },
				{ "name": "Source Serif 4", "slug": "serif", "fontFamily": "'Source Serif 4', Georgia, serif" }
			],
			"fontSizes": [
				{ "name": "Small",   "slug": "small",   "size": "0.875rem" },
				{ "name": "Medium",  "slug": "medium",  "size": "1rem" },
				{ "name": "Large",   "slug": "large",   "size": "1.25rem" },
				{ "name": "X-Large", "slug": "x-large", "size": "1.875rem" },
				{ "name": "Huge",    "slug": "huge",    "size": "3rem" }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "em", "%", "vw", "vh" ],
			"spacingSizes": [
				{ "name": "Small",    "slug": "20", "size": "1rem" },
				{ "name": "Medium",   "slug": "40", "size": "2rem" },
				{ "name": "Large",    "slug": "60", "size": "4rem" },
				{ "name": "X-Large",  "slug": "80", "size": "5rem" }
			]
		},
		"border": {
			"radius": true,
			"color": true,
			"style": true,
			"width": true
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--foreground)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"padding": {
				"left": "1.5rem",
				"right": "1.5rem"
			},
			"blockGap": "1.5rem"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--primary)" },
				":hover": { "typography": { "textDecoration": "underline" } }
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontWeight": "700",
					"lineHeight": "1.2"
				},
				"color": { "text": "var(--wp--preset--color--foreground)" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--primary-contrast)"
				},
				"border": { "radius": "0.375rem" },
				"spacing": { "padding": { "top": "0.6rem", "bottom": "0.6rem", "left": "1.1rem", "right": "1.1rem" } },
				":hover": {
					"color": { "background": "oklch(0.2600 0.1600 320)" }
				}
			}
		},
		"blocks": {
			"core/button": {
				"border": { "radius": "0.375rem" }
			},
			"core/heading": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--sans)", "fontWeight": "700" }
			}
		}
	}
}
